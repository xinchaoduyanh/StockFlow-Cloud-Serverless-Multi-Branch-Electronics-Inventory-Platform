DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow_cloud?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
CORS_ORIGIN="http://localhost:3000"
SWAGGER_ENABLED="true"
PRISMA_CONNECT_ON_BOOT="false"

# AWS S3 Settings (Phase 2 Serverless Ingestion)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="replace-with-your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-your-aws-secret-access-key"
AWS_S3_BUCKET="stockflow-imports-dev"
AWS_S3_ENDPOINT=""

# Event-driven recovery (Phase E3)
# Set REPORT_DISPATCH_MODE=sqs with REPORT_QUEUE_URL in production.
REPORT_DISPATCH_MODE="local"
REPORT_QUEUE_URL=""
REPORT_QUEUE_DLQ_URL=""
REPORT_MAX_RECEIVE_COUNT="5"
REPORT_PROCESSING_LEASE_SECONDS="900"
IMPORT_STATE_MACHINE_ARN=""
IMPORT_RECOVERY_QUEUE_URL=""
IMPORT_RECOVERY_DLQ_URL=""
IMPORT_APPROVAL_TIMEOUT_SECONDS="86400"
IMPORT_MAX_REPLAY_COUNT="3"
NOTIFICATION_SNS_TOPIC_ARN=""
SNS_CALLBACK_ALLOW_LOCAL="true"

SYSTEM_FROM_EMAIL=""

# AWS Cognito Authentication Settings
AUTH_MODE="cognito"
COGNITO_REGION="ap-southeast-1"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
